-- v0.129.0 Regression Tests
-- Tests for: CONFLICT-03 — Datalog materialisation writes vp_rare.source = 1
--            and the conflict gate (PT0451) is paritated between infer() and
--            infer_with_stats().
--
-- Covers:
--   SRC-GATE-1: infer_with_stats() materialises derived triples with source = 1
--   SRC-GATE-2: rule_conflicts(rs, 'runtime') detects the contradiction
--   SRC-GATE-3: block_on_conflict = on raises PT0451 in infer_with_stats()
--   SRC-GATE-4: dedicated-VP predicates (e.g. depends_on in production) are
--               covered — derived rows land in the canonical {vp}_delta with
--               source = 1 (v0.130.0 VAL-207 CANON-TARGET)
--   SRC-GATE-5: with plain-path provenance shipped (VAL-207 option A), the
--               gate on the production write path is live: infer() raises
--               PT0451 on its own recorded conflicts; without recording the
--               gate stays inert
--   SRC-GATE-7: remove_rule() retracts derived facts (DELETE ... source = 1)
--
-- NOTE: the conflicting rules below use distinct body predicates on purpose.
-- check_subsumption() compares body-predicate multisets only and eliminates a
-- later rule whose body-predicate multiset equals an earlier rule's — even when
-- the constant arguments differ (upstream defect, tracked separately).  Rules
-- sharing the body predicate would silently lose one side of the conflict.
--
-- Namespace: https://val197.test/
-- The "loaded without shared_preload_libraries" WARNING is emitted either at
-- CREATE EXTENSION or at LOAD depending on whether the library was already
-- loaded in this session — suppress it so the expected output is order-stable.
SET client_min_messages = error;
CREATE EXTENSION IF NOT EXISTS pg_ripple;
SET search_path TO pg_ripple, public;
-- Load library so _PG_init registers GUCs (required when shared_preload_libraries is not set).
LOAD '$libdir/pg_ripple';
SET client_min_messages = DEFAULT;
-- Provenance recording is required for the runtime conflict scan.
SET pg_ripple.record_derivations = on;
-- Helper: run a statement, swallow errors, return SQLERRM (or 'no_error').
CREATE FUNCTION pg_temp.catch_error(stmt TEXT) RETURNS TEXT AS $$
DECLARE
    err TEXT;
BEGIN
    BEGIN
        EXECUTE stmt;
    EXCEPTION WHEN OTHERS THEN
        RETURN SQLERRM;
    END;
    RETURN 'no_error';
END;
$$ LANGUAGE plpgsql;
-- Helper: rows of a predicate's promoted delta table with source = 1.
CREATE FUNCTION pg_temp.delta_inferred_count(pred TEXT) RETURNS BIGINT AS $$
DECLARE
    n BIGINT;
    p_id BIGINT;
BEGIN
    SELECT id INTO p_id FROM _pg_ripple.dictionary WHERE value = pred LIMIT 1;
    EXECUTE format('SELECT count(*) FROM _pg_ripple.vp_%s_delta WHERE source = 1', p_id)
    INTO n;
    RETURN n;
END;
$$ LANGUAGE plpgsql;
-- ══════════════════════════════════════════════════════════════════════════════
-- SRC-GATE-1 / SRC-GATE-2: semi-naive materialises source = 1 and runtime
-- detection finds the contradiction.
-- ══════════════════════════════════════════════════════════════════════════════
SELECT pg_ripple.drop_rules('sg_flag') >= 0 AS sg_flag_rules_dropped;
 sg_flag_rules_dropped 
-----------------------
 t
(1 row)

SELECT pg_ripple.load_rules(
    '?x <https://val197.test/flag> "yes" :- ?x <https://val197.test/trigger_a> "A" .
     ?x <https://val197.test/flag> "no"  :- ?x <https://val197.test/trigger_b> "B" .',
    'sg_flag'
) = 2 AS sg_flag_rules_loaded;
 sg_flag_rules_loaded 
----------------------
 t
(1 row)

SELECT pg_ripple.insert_triple(
    '<https://val197.test/Alice>',
    '<https://val197.test/trigger_a>',
    '"A"'
) >= 1 AS sg_flag_trigger_a_inserted;
 sg_flag_trigger_a_inserted 
----------------------------
 t
(1 row)

SELECT pg_ripple.insert_triple(
    '<https://val197.test/Alice>',
    '<https://val197.test/trigger_b>',
    '"B"'
) >= 1 AS sg_flag_trigger_b_inserted;
 sg_flag_trigger_b_inserted 
----------------------------
 t
(1 row)

SELECT (pg_ripple.infer_with_stats('sg_flag') ->> 'derived')::bigint >= 2
    AS sg_flag_stats_derived_conflicting_pair;
 sg_flag_stats_derived_conflicting_pair 
----------------------------------------
 t
(1 row)

-- THE FIX: derived triples must carry source = 1 (pre-fix: 0).
SELECT count(*) = 2 AS sg_flag_derived_rows_have_source_1
FROM _pg_ripple.vp_rare
WHERE p = (SELECT id FROM _pg_ripple.dictionary
           WHERE value = 'https://val197.test/flag')
  AND source = 1;
 sg_flag_derived_rows_have_source_1 
------------------------------------
 t
(1 row)

-- THE PAYOFF: the runtime scan joins derivations with vp_rare ... source = 1
-- and must now find the contradiction (pre-fix: always []).
SELECT jsonb_array_length(pg_ripple.rule_conflicts('sg_flag', 'runtime')) > 0
    AS sg_flag_runtime_scan_detects_conflict;
 sg_flag_runtime_scan_detects_conflict 
---------------------------------------
 t
(1 row)

-- ══════════════════════════════════════════════════════════════════════════════
-- SRC-GATE-4: predicate with a dedicated VP table (production shape of
-- depends_on / vp_534).  Asserted rows get promoted; rule-derived rows still
-- materialise in vp_rare — now with source = 1, so the runtime scan sees them.
-- ══════════════════════════════════════════════════════════════════════════════
SET pg_ripple.vp_promotion_threshold = 100;
-- 100 asserted triples push the predicate over the promotion threshold.
DO $$
DECLARE
    i INT;
BEGIN
    FOR i IN 1..100 LOOP
        PERFORM pg_ripple.insert_triple(
            '<https://val197.test/Svc' || i || '>',
            '<https://val197.test/depends_on>',
            '<https://val197.test/SvcA>'
        );
    END LOOP;
END;
$$;
SELECT table_oid IS NOT NULL AS sg_dep_predicate_has_dedicated_vp_table
FROM _pg_ripple.predicates
WHERE id = (SELECT id FROM _pg_ripple.dictionary
            WHERE value = 'https://val197.test/depends_on');
 sg_dep_predicate_has_dedicated_vp_table 
-----------------------------------------
 t
(1 row)

SELECT pg_ripple.drop_rules('sg_dep') >= 0 AS sg_dep_rules_dropped;
 sg_dep_rules_dropped 
