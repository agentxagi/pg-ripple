-- ══════════════════════════════════════════════════════════════════════════════
-- Cleanup — keep the suite namespace-clean for the other tests.
-- ══════════════════════════════════════════════════════════════════════════════
SET pg_ripple.record_derivations = off;
SET pg_ripple.block_on_conflict = off;
DO $$
DECLARE
    r RECORD;
BEGIN
    FOR r IN
        SELECT p.id,
               p.table_oid IS NOT NULL AS has_dedicated
        FROM _pg_ripple.predicates p
        JOIN _pg_ripple.dictionary d ON d.id = p.id
        WHERE d.value LIKE 'https://val197.test/%'
    LOOP
        EXECUTE format('DELETE FROM _pg_ripple.vp_rare WHERE p = %s', r.id);
        IF r.has_dedicated THEN
            EXECUTE format('DELETE FROM _pg_ripple.vp_%s_delta', r.id);
        END IF;
    END LOOP;

    DELETE FROM _pg_ripple.derivations
    WHERE rule_set IN ('sg_flag', 'sg_dep', 'sg_block', 'sg_plain', 'sg_dred');
END;
$$;
SELECT pg_ripple.drop_rules('sg_flag') >= 0 AS sg_flag_cleanup;
 sg_flag_cleanup 
