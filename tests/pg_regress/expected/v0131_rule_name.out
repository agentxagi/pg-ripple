(1 row)

SELECT pg_ripple.infer('v208_auto') >= 1 AS auto_infer_derived;
 auto_infer_derived 
--------------------
 t
(1 row)

SELECT (SELECT d.rule_name FROM _pg_ripple.derivations d WHERE d.rule_set = 'v208_auto')
     = (SELECT 'auto:' || left(md5(r.rule_text), 12)
        FROM _pg_ripple.rules r WHERE r.rule_set = 'v208_auto')
   AND (SELECT name FROM _pg_ripple.rules WHERE rule_set = 'v208_auto')
     = (SELECT d.rule_name FROM _pg_ripple.derivations d WHERE d.rule_set = 'v208_auto')
    AS val208_auto1_fingerprint_parity;
