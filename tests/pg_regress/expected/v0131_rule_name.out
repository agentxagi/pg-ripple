-- ── VAL208-JUSTIFY-1: proof tree resolves text and exposes the identity ─────
SELECT (pg_ripple.justify(
    'https://val208.test/A',
    'https://val208.test/ancestor',
    'https://val208.test/C')::jsonb -> 'derivations' -> 0 ->> 'rule_name') = 'transitive'
    AS val208_justify1_identity;
 val208_justify1_identity 
--------------------------
 t
(1 row)

SELECT (pg_ripple.justify(
    'https://val208.test/A',
    'https://val208.test/ancestor',
    'https://val208.test/C')::jsonb -> 'derivations' -> 0 ->> 'rule')
    = '?x <https://val208.test/ancestor> ?w :- ?x <https://val208.test/parent> ?y, ?y <https://val208.test/parent> ?w .'
    AS val208_justify1_rule_text_resolved;
 val208_justify1_rule_text_resolved 
------------------------------------
 t
(1 row)

-- ── VAL208-DUP-ERR: duplicate @name labels rejected (PT0302) ────────────────
CREATE TABLE pg_temp.err_captured(msg TEXT);
DO $$
BEGIN
    BEGIN
        PERFORM pg_ripple.load_rules(
            '?x <https://val208.test/a> ?y :- ?x <https://val208.test/b> ?y @name("dup") . ?x <https://val208.test/c> ?y :- ?x <https://val208.test/b> ?y @name("dup") .',
            'v208_dup');
        INSERT INTO pg_temp.err_captured VALUES ('load_rules succeeded — expected PT0302');
    EXCEPTION WHEN OTHERS THEN
        INSERT INTO pg_temp.err_captured VALUES (SQLERRM);
    END;
END $$;
SELECT msg LIKE '%PT0302%' AS val208_dup_err_rejected FROM pg_temp.err_captured;
 val208_dup_err_rejected 
-------------------------
 t
(1 row)

-- ── VAL208-COLLAPSE: identical duplicated rules collapse to one row ─────────
SELECT pg_ripple.load_rules(
    '?x <https://val208.test/e> ?y :- ?x <https://val208.test/f> ?y . ?x <https://val208.test/e> ?y :- ?x <https://val208.test/f> ?y .',
    'v208_collapse') = 2 AS collapse_load_reports_both_attempts;
 collapse_load_reports_both_attempts 
-------------------------------------
 t
(1 row)

SELECT count(*) = 1 AS val208_collapse_one_catalog_row
FROM _pg_ripple.rules WHERE rule_set = 'v208_collapse';
 val208_collapse_one_catalog_row 
---------------------------------
 t
(1 row)

SELECT count(*) = 1 AS val208_collapse_one_name
FROM (SELECT DISTINCT name FROM _pg_ripple.rules WHERE rule_set = 'v208_collapse') n;
 val208_collapse_one_name 
