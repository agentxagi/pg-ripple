-- v0.131.0 regression tests (VAL-208): stable rule identity for derivations.
--
-- Covers:
--   VAL208-NAMED-1: @name("label") becomes derivations.rule_name verbatim and
--                   the catalog stores the clean rule text + the label
--   VAL208-AUTO-1:  unnamed rules record 'auto:<md5-12>' — identical to the
--                   fingerprint recomputed in SQL from rules.rule_text
--                   (Rust <-> SQL parity)
--   VAL208-EDIT-STABLE: editing a named rule (same @name) keeps one derivation
--                   per fact; the identity survives the edit
--   VAL208-EDIT-AUTO:  editing an unnamed rule prunes the vanished identity
--                   and records the new one — no stale rows, no duplicates
--   VAL208-JUSTIFY-1:  proof-tree nodes carry the resolved rule text (`rule`)
--                   and the stable identity (`rule_name`)
--   VAL208-DUP-ERR: duplicate @name labels in one load are rejected (PT0302)
--   VAL208-COLLAPSE: identical duplicated rules collapse to one catalog row
--
-- Namespace: https://val208.test/
SET client_min_messages = error;
CREATE EXTENSION IF NOT EXISTS pg_ripple;
SET search_path TO pg_ripple, public;
-- Load so _PG_init registers GUCs (no shared_preload_libraries in tests).
LOAD '$libdir/pg_ripple';
SET client_min_messages = DEFAULT;
SET pg_ripple.record_derivations = on;
CREATE FUNCTION pg_temp.sid_of(subject TEXT, pred TEXT, object TEXT) RETURNS BIGINT AS $$
DECLARE
    p_id BIGINT; s_id BIGINT; o_id BIGINT; sid BIGINT;
BEGIN
    SELECT id INTO p_id FROM _pg_ripple.dictionary WHERE value = pred LIMIT 1;
    SELECT id INTO s_id FROM _pg_ripple.dictionary WHERE value = subject LIMIT 1;
    SELECT id INTO o_id FROM _pg_ripple.dictionary WHERE value = object LIMIT 1;
    -- Derived facts live in the predicate's HTAP delta (VAL-207 canonical
    -- storage); asserted rare facts live in vp_rare.
    EXECUTE format(
        'SELECT i FROM _pg_ripple.vp_%s_delta WHERE s = $1 AND o = $2 AND g = 0 LIMIT 1',
        p_id) INTO sid USING s_id, o_id;
    IF sid IS NULL THEN
        SELECT i INTO sid FROM _pg_ripple.vp_rare
        WHERE p = p_id AND s = s_id AND o = o_id LIMIT 1;
    END IF;
    RETURN sid;
END $$ LANGUAGE plpgsql;
-- Derivation count for a fact.
CREATE FUNCTION pg_temp.deriv_count(subject TEXT, pred TEXT, object TEXT) RETURNS BIGINT AS $$
    SELECT count(*) FROM _pg_ripple.derivations
    WHERE derived_sid = pg_temp.sid_of(subject, pred, object)
$$ LANGUAGE sql;
-- Derivation name for a fact (single row expected).
CREATE FUNCTION pg_temp.deriv_name(subject TEXT, pred TEXT, object TEXT) RETURNS TEXT AS $$
    SELECT rule_name FROM _pg_ripple.derivations
    WHERE derived_sid = pg_temp.sid_of(subject, pred, object)
    ORDER BY rule_name LIMIT 1
$$ LANGUAGE sql;
-- ── VAL208-NAMED-1: explicit @name label ─────────────────────────────────────
SELECT pg_ripple.drop_rules('v208_named') >= 0 AS named_ruleset_dropped;
 named_ruleset_dropped 
-----------------------
 t
(1 row)

SELECT pg_ripple.load_rules(
    '?x <https://val208.test/ancestor> ?z :- ?x <https://val208.test/parent> ?y, ?y <https://val208.test/parent> ?z @name("transitive") .',
    'v208_named'
) = 1 AS named_rule_loaded;
 named_rule_loaded 
-------------------
 t
(1 row)

SELECT pg_ripple.insert_triple(
    '<https://val208.test/A>', '<https://val208.test/parent>', '<https://val208.test/B>'
) >= 1 AS parent_ab_inserted;
 parent_ab_inserted 
--------------------
 t
(1 row)

SELECT pg_ripple.insert_triple(
    '<https://val208.test/B>', '<https://val208.test/parent>', '<https://val208.test/C>'
) >= 1 AS parent_bc_inserted;
 parent_bc_inserted 
--------------------
 t
(1 row)

SELECT pg_ripple.infer('v208_named') >= 1 AS named_infer_derived;
 named_infer_derived 
---------------------
 t
(1 row)

SELECT pg_temp.deriv_count(
    'https://val208.test/A', 'https://val208.test/ancestor', 'https://val208.test/C') = 1
    AS val208_named1_single_derivation;
 val208_named1_single_derivation 
---------------------------------
 t
(1 row)

SELECT pg_temp.deriv_name(
    'https://val208.test/A', 'https://val208.test/ancestor', 'https://val208.test/C') = 'transitive'
    AS val208_named1_label_recorded;
 val208_named1_label_recorded 
------------------------------
 t
(1 row)

-- The catalog stores the clean rule text (annotation stripped) + the label.
SELECT rule_text = '?x <https://val208.test/ancestor> ?z :- ?x <https://val208.test/parent> ?y, ?y <https://val208.test/parent> ?z .'
    AND name = 'transitive'
    AS val208_named1_catalog_row
FROM _pg_ripple.rules WHERE rule_set = 'v208_named';
 val208_named1_catalog_row 
---------------------------
 t
(1 row)

-- ── VAL208-AUTO-1: auto fingerprint, Rust <-> SQL parity ────────────────────
SELECT pg_ripple.drop_rules('v208_auto') >= 0 AS auto_ruleset_dropped;
 auto_ruleset_dropped 
----------------------
 t
(1 row)

SELECT pg_ripple.load_rules(
    '?x <https://val208.test/reach> ?y :- ?x <https://val208.test/link> ?y .',
    'v208_auto'
) = 1 AS auto_rule_loaded;
 auto_rule_loaded 
------------------
 t
(1 row)

SELECT pg_ripple.insert_triple(
    '<https://val208.test/N1>', '<https://val208.test/link>', '<https://val208.test/N2>'
) >= 1 AS link_inserted;
 link_inserted 
---------------
