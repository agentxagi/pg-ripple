-- ── VAL208-EDIT-AUTO: edited unnamed rule prunes the vanished identity ───────
SELECT pg_ripple.load_rules(
    '?x <https://val208.test/reach> ?z :- ?x <https://val208.test/link> ?z .',
    'v208_auto'
) = 1 AS auto_rule_reloaded_after_edit;
 auto_rule_reloaded_after_edit 
-------------------------------
 t
(1 row)

-- The old fingerprint is gone from the set's derivations.
SELECT count(*) = 0 AS val208_edit_auto_stale_pruned
FROM _pg_ripple.derivations
WHERE rule_set = 'v208_auto'
  AND rule_name <> (SELECT name FROM _pg_ripple.rules WHERE rule_set = 'v208_auto');
 val208_edit_auto_stale_pruned 
-------------------------------
 t
(1 row)

-- The old fact's derivation no longer exists (its identity vanished).
SELECT pg_temp.deriv_count(
    'https://val208.test/N1', 'https://val208.test/reach', 'https://val208.test/N2') = 0
    AS val208_edit_auto_old_row_pruned;
 val208_edit_auto_old_row_pruned 
---------------------------------
 t
(1 row)

